#!/usr/bin/env ruby
require "yaml"

args = ARGV.dup
args.shift if %w[e eval].include?(args.first)
in_place = !args.delete("-i").nil?
expression = args.shift
path = args.shift
data = YAML.load_file(path)

case expression
when ".user"
  puts data["user"]
when ".keys | length"
  puts Array(data["keys"]).length
when ".keys[].filename"
  puts Array(data["keys"]).map { |key| key["filename"] }
when /\A\.keys\[(\d+)\]\.(filename|expires_at)\z/
  value = Array(data["keys"])[Regexp.last_match(1).to_i][Regexp.last_match(2)]
  puts value.nil? ? "null" : value
when /\Adel\(\.keys\[(\d+)\]\)\z/
  Array(data["keys"]).delete_at(Regexp.last_match(1).to_i)
when /\A\.jobs\.(validate|deploy|cleanup)\.if\z/
  puts data.fetch("jobs").fetch(Regexp.last_match(1)).fetch("if")
when /\A\.jobs\.(deploy|cleanup)\.concurrency\.(group|cancel-in-progress)\z/
  value = data.fetch("jobs").fetch(Regexp.last_match(1)).fetch("concurrency", {})[Regexp.last_match(2)]
  puts value.nil? ? "null" : value
when /\A\.jobs\.cleanup\.steps\[\] \| select\(\.(uses|id|name) == "([^"]+)"\) \| \.(with\.ref|if|run)\z/
  selector_key = Regexp.last_match(1)
  selector_value = Regexp.last_match(2)
  result_path = Regexp.last_match(3).split(".")
  step = data.fetch("jobs").fetch("cleanup").fetch("steps").find do |candidate|
    candidate[selector_key] == selector_value
  end
  value = result_path.reduce(step) { |current, key| current.is_a?(Hash) ? current[key] : nil }
  puts value.nil? ? "null" : value
else
  warn "unsupported yq expression: #{expression}"
  exit 2
end

File.write(path, data.to_yaml) if in_place
